@baseUrl = http://localhost:8080
@json = application/json
@supportUserId = 00000000-0000-0000-0000-000000000303
@supportTeamId = 00000000-0000-0000-0000-000000000401

### 知识库演示使用下面第 4 步获取的 adminToken

### 1. 客户登录
POST {{baseUrl}}/api/v1/auth/login
Content-Type: {{json}}

{
  "tenantId": "default",
  "username": "customer",
  "password": "Admin@123456"
}

> {% client.global.set("customerToken", response.body.data.accessToken); %}

### 2. 创建工单；重复执行会返回同一个 ticketId
POST {{baseUrl}}/api/v1/tickets
Authorization: Bearer {{customerToken}}
Idempotency-Key: demo-create-ticket-001
Content-Type: {{json}}

{
  "title": "VPN 无法连接",
  "description": "客户端提示认证失败，请协助处理。",
  "priority": "HIGH"
}

> {%
    client.global.set("ticketId", response.body.data.id);
    client.global.set("ticketVersion", response.body.data.version);
%}

### 3. 分页并按状态查询本人工单
GET {{baseUrl}}/api/v1/tickets?status=NEW&page=0&size=20
Authorization: Bearer {{customerToken}}

### 4. 管理员登录
POST {{baseUrl}}/api/v1/auth/login
Content-Type: {{json}}

{
  "tenantId": "default",
  "username": "admin",
  "password": "Admin@123456"
}

> {% client.global.set("adminToken", response.body.data.accessToken); %}

### 5. 分派到默认客服组及客服
POST {{baseUrl}}/api/v1/tickets/{{ticketId}}/assignments
Authorization: Bearer {{adminToken}}
Content-Type: {{json}}

{
  "teamId": "{{supportTeamId}}",
  "assigneeId": "{{supportUserId}}",
  "reason": "分派给默认客服组",
  "expectedVersion": {{ticketVersion}}
}

> {% client.global.set("ticketVersion", response.body.data.version); %}

### 6. NEW -> PENDING
POST {{baseUrl}}/api/v1/tickets/{{ticketId}}/transitions
Authorization: Bearer {{adminToken}}
Content-Type: {{json}}

{
  "toStatus": "PENDING",
  "reason": "已进入客服队列",
  "commandId": "demo-transition-pending-001",
  "expectedVersion": {{ticketVersion}}
}

> {% client.global.set("ticketVersion", response.body.data.version); %}

### 7. 查询详情
GET {{baseUrl}}/api/v1/tickets/{{ticketId}}
Authorization: Bearer {{adminToken}}

### 8. 查询分派历史
GET {{baseUrl}}/api/v1/tickets/{{ticketId}}/assignments
Authorization: Bearer {{adminToken}}

### 9. 查询状态流转历史
GET {{baseUrl}}/api/v1/tickets/{{ticketId}}/transitions
Authorization: Bearer {{adminToken}}

### 10. 创建知识文章
POST {{baseUrl}}/api/v1/knowledge/articles
Authorization: Bearer {{adminToken}}
Content-Type: {{json}}

{
  "title": "企业账号登录排障指南"
}

> {% client.global.set("knowledgeArticleId", response.body.data.id); %}

### 11. 创建内容草稿版本
POST {{baseUrl}}/api/v1/knowledge/articles/{{knowledgeArticleId}}/versions
Authorization: Bearer {{adminToken}}
Content-Type: {{json}}

{
  "content": "企业账号登录失败时，请先检查账号是否被锁定，再确认双重认证设备时间正确。若无法自行恢复，请联系管理员。"
}

> {% client.global.set("knowledgeVersionId", response.body.data.id); %}

### 12. 审核发布并自动分块
POST {{baseUrl}}/api/v1/knowledge/articles/{{knowledgeArticleId}}/versions/{{knowledgeVersionId}}/publish
Authorization: Bearer {{adminToken}}

### 13. 中文关键词检索当前发布版本
GET {{baseUrl}}/api/v1/knowledge/search?q=登录&limit=10
Authorization: Bearer {{adminToken}}

### 14. 查看文章和版本
GET {{baseUrl}}/api/v1/knowledge/articles/{{knowledgeArticleId}}
Authorization: Bearer {{adminToken}}

### 15. 查看版本列表
GET {{baseUrl}}/api/v1/knowledge/articles/{{knowledgeArticleId}}/versions
Authorization: Bearer {{adminToken}}

### 16. 撤回；再次检索将不再命中此文章
POST {{baseUrl}}/api/v1/knowledge/articles/{{knowledgeArticleId}}/withdraw
Authorization: Bearer {{adminToken}}
